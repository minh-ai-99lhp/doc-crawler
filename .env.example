# Copy file này thành .env rồi điền giá trị thật. (.env đã được .gitignore)
# Định dạng KEY=VALUE, mỗi dòng một biến. Giá trị KHÔNG cần dấu ngoặc.

# ===== Trang nguồn =====
SITE_BASE_URL=https://example.com

# ===== Tài khoản đăng nhập =====
# (thay cho auth.json — chọn 1 trong 2, .env được ưu tiên)
SITE_USER=ten_dang_nhap_hoac_email
SITE_PASS=mat_khau

# ===== Xoay tài khoản + ExpressVPN =====
# Hai lane dùng chung SITE_PASS. Mỗi user xuất hiện hai lần để ghép đủ 10 location.
SITE_ROTATION_SECONDS=5400
SITE_ROTATION_USERS_A=account01,account02,account03,account04,account05,account01,account02,account03,account04,account05
SITE_ROTATION_USERS_B=account06,account07,account08,account09,account10,account06,account07,account08,account09,account10
SITE_ROTATION_LOCATIONS=hong-kong-1,taiwan-3,japan-tokyo,south-korea-2,australia-perth,hong-kong-2,taiwan-3,japan-osaka,south-korea-2,australia-sydney-2
# WSL gọi trực tiếp ExpressVPN CLI đã đăng nhập trên Windows.
EXPRESSVPN_BIN=/mnt/c/Program Files/ExpressVPN/expressvpnctl.exe
SITE_ROTATION_QUEUE_ORDER=queue/queue_1.json,queue/queue_2.json,queue/queue_3.json
SITE_ROTATION_OUT_DIR=downloads
SITE_ROTATION_MIN_DELAY=10
SITE_ROTATION_MAX_DELAY=18
SITE_CF_STALLED_TIMEOUT_SECONDS=120
SITE_CF_STABLE_FRAMES=3
SITE_CF_FRAME_INTERVAL_SECONDS=0.5
SITE_SOFT_BLOCK_COOLDOWN_SECONDS=120
SITE_MIN_VPN_DWELL_SECONDS=900
SITE_BROWSER_RESTART_DELAY_SECONDS=60
SITE_LANE_STALL_TIMEOUT_SECONDS=300

# Chỉ cần khi chạy Python trực tiếp trên Windows và tesseract.exe không có trong PATH.
# Docker đã cài sẵn Tesseract nên để trống.
#TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ===== Thông báo Telegram =====
# Bật gửi Telegram: 1 = bật, 0 = tắt
TELEGRAM_ENABLED=0
# Token bot lấy từ @BotFather (dạng 123456789:ABC...)
TELEGRAM_BOT_TOKEN=
# Nơi nhận thông báo: user id, group id (số, có thể âm), hoặc @tenkenh
TELEGRAM_CHAT_ID=
# Chỉ báo khi LỖI (1) hay báo cả khi thành công (0)
TELEGRAM_ONLY_ON_FAIL=1

# ===== AI (Claude Code CLI) =====
# 1 = có AI (fail: tự chẩn đoán/sửa + báo cáo; success: AI tổng hợp báo cáo)
# 0 = KHÔNG AI; báo cáo Telegram theo mẫu FIX CỨNG dựng từ logs/last-summary.json
# Bật ở đây là đủ cho CẢ chạy trực tiếp lẫn Docker (container đã có sẵn `claude`,
# không cần build lại image). Nếu bật mà claude chưa xác thực được -> run.sh tự lùi
# về báo cáo mẫu fix cứng, không im lặng.
AI_ENABLED=1

# Chốt chặn nếu Playwright/Camoufox treo hoàn toàn (mặc định 2 giờ).
CRAWLER_MAX_RUNTIME_SECS=7200

# Xác thực cho `claude` — CHỌN 1 TRONG 2, chỉ cần khi AI_ENABLED=1:
#  (a) API key trả theo lượng dùng: bỏ comment dòng dưới và điền key.
#ANTHROPIC_API_KEY=sk-ant-...
#  (b) Tài khoản Claude (Pro/Max): KHÔNG điền gì ở đây, mà đăng nhập 1 lần:
#      - chạy trực tiếp:  claude   (rồi /login)
#      - Docker:          docker compose -f .docker/docker-compose.yml run --rm crawler claude
#      Phiên đăng nhập được giữ lại (host: ~/.claude, Docker: ./.claude-docker/).
